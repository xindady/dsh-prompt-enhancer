{
  "name": "dsh-prompt-enhancer",
  "version": "1.1.0",
  "description": "One-click prompt enhancement for the composer: rewrite the draft with prompt-engineering rules, write it back undoably, and keep @file references verbatim.",
  "icon": "./icon.svg",
  "type": "module",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xindady/dsh-prompt-enhancer.git"
  },
  "homepage": "https://github.com/xindady/dsh-prompt-enhancer#readme",
  "bugs": {
    "url": "https://github.com/xindady/dsh-prompt-enhancer/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "prompt",
    "prompt-engineering",
    "prompt-engineering"
  ],
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
